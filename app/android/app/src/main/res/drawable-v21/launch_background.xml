<?xml version="1.0" encoding="utf-8"?>
<!-- Ecran de lancement natif (avant Android 12) : fond vert tres pale du
     splash et logo MonCheptel au centre, le temps que Flutter demarre.
     Le splash anime de l'application prend ensuite le relais. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/fond_demarrage" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/logo_demarrage" />
    </item>
</layer-list>
