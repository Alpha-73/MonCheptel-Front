<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 et plus : l'ecran de lancement du systeme montre
         l'embleme MonCheptel sur le fond du splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/fond_demarrage</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/embleme_demarrage</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/fond_demarrage</item>
    </style>
</resources>
